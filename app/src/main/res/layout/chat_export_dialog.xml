<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:viewBindingIgnore="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="noExcludeDescendants"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp">

        <RadioGroup
            android:id="@+id/chat_export_format"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/chat_export_format_html">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/chat_export_format_html"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ChatExportDialog__format_html" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/chat_export_format_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ChatExportDialog__format_text" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/chat_export_format_json"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ChatExportDialog__format_json" />
        </RadioGroup>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chat_export_include_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/ChatExportDialog__include_media" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/chat_export_encrypt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/ChatExportDialog__encrypt_with_a_passphrase" />

        <LinearLayout
            android:id="@+id/chat_export_passphrase_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ChatExportDialog__encrypt_explanation"
                android:textAppearance="@style/Signal.Text.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/chat_export_passphrase_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/chat_export_passphrase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ChatExportDialog__passphrase"
                    android:imeOptions="actionNext|flagNoPersonalizedLearning"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/chat_export_repeat_passphrase_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:passwordToggleEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/chat_export_repeat_passphrase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ChatExportDialog__repeat_passphrase"
                    android:imeOptions="actionDone|flagNoPersonalizedLearning"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/chat_export_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ChatExportDialog__warning"
            android:textAppearance="@style/Signal.Text.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
